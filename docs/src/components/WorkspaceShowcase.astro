---
const copy = {
	en: {
		alt: 'Animated demo of an f0 task: Claude Code adds retries to wallet.ts, the edit lands in Neovim and in the changes list, the new files show up in the explorer, the workspace switches to dark mode, and the server, tests, typecheck and a shell keep running in the bottom row.',
		captions: {
			overview: ['f0', 'one task, one worktree: agent, editor and servers in one view'],
			agent: ['Agent', 'prompt it in plain English'],
			editor: ['File', 'watch the edit land in Neovim'],
			changes: ['Changes', 'pick a touched file, its diff opens in File'],
			explorer: ['Explorer', 'new files show up as the agent writes them'],
			terminals: ['Terminals', 'servers, tests and typecheck keep running'],
			dark: ['Dark mode', 'same layout, your colors'],
			done: ['f0', 'review, commit and ship without leaving the task'],
		},
	},
	es: {
		alt: 'Demo animada de una tarea de f0: Claude Code agrega reintentos a wallet.ts, el cambio aparece en Neovim y en la lista de cambios, los archivos nuevos aparecen en el explorador, el espacio de trabajo pasa a modo oscuro, y el servidor, los tests, el typecheck y una shell siguen corriendo en la fila de abajo.',
		captions: {
			overview: ['f0', 'una tarea, un worktree: agente, editor y servidores a la vista'],
			agent: ['Agente', 'pedile lo que necesitás en lenguaje natural'],
			editor: ['Archivo', 'mirá cómo el cambio llega a Neovim'],
			changes: ['Cambios', 'elegí un archivo tocado y su diff se abre en Archivo'],
			explorer: ['Explorador', 'los archivos nuevos aparecen a medida que el agente los escribe'],
			terminals: ['Terminales', 'servidores, tests y typecheck siguen corriendo'],
			dark: ['Modo oscuro', 'el mismo layout, tus colores'],
			done: ['f0', 'revisá, commiteá y publicá sin salir de la tarea'],
		},
	},
	'zh-CN': {
		alt: 'f0 任务的动画演示：Claude Code 为 wallet.ts 加入重试，改动出现在 Neovim 和改动列表中，新文件出现在文件浏览器里，工作区切换到深色模式，底部一行的服务器、测试、类型检查和 shell 持续运行。',
		captions: {
			overview: ['f0', '一个任务，一个 worktree：智能体、编辑器和服务器尽在一屏'],
			agent: ['智能体', '用自然语言给它下指令'],
			editor: ['文件', '看着改动落进 Neovim'],
			changes: ['改动', '选一个改过的文件，它的 diff 会在“文件”中打开'],
			explorer: ['文件浏览器', '智能体写入的新文件会随之出现'],
			terminals: ['终端', '服务器、测试和类型检查持续运行'],
			dark: ['深色模式', '同样的布局，你的配色'],
			done: ['f0', '审查、提交、发布，全程不离开任务'],
		},
	},
};

// Keyed by the page's lang, which is what Astro.currentLocale returns.
const t = copy[Astro.currentLocale as keyof typeof copy] ?? copy.en;
const terminals = ['t1', 't2', 't3', 't4'];
---

<f0-showcase class="not-content" role="img" aria-label={t.alt} data-captions={JSON.stringify(t.captions)}>
	<div class="window" aria-hidden="true">
		<div class="stage">
			<div class="world">
				<div class="win">
					<div class="titlebar"><div class="lights"><i></i><i></i><i></i></div><span class="ttl">f0</span></div>
					<div class="top">
						<div class="left">
							<div class="cols">
								<section class="panel" data-panel="changes"></section>
								<section class="panel" data-panel="editor"></section>
								<section class="panel" data-panel="explorer"></section>
							</div>
							<div class="status">
								<span class="mode">NORMAL</span><span class="dim">⎇ F0-123</span><span class="stfile dim"></span><span class="sp"></span><span class="pos dim">1:1</span>
							</div>
						</div>
						<section class="panel" data-panel="agent"></section>
					</div>
					<div class="terms">
						{terminals.map((id) => <section class="panel term" data-panel={id} />)}
					</div>
					<div class="bottombar">
						<span class="foot">f0-demo/F0-123</span><span class="sp"></span><span class="dim">C-a X close task</span><span class="dim">~/.treehouse/f0-demo-3a91c/2/f0-demo</span>
					</div>
				</div>
			</div>
			<div class="cap hide"></div>
			<div class="outro">
				<div class="ovw">
					<div class="end"><span class="a">f0</span><span class="b">.falcondpr.com</span></div>
				</div>
			</div>
		</div>
	</div>
</f0-showcase>

<script>
	type CaptionKey = 'overview' | 'agent' | 'editor' | 'changes' | 'explorer' | 'terminals' | 'dark' | 'done';
	type Captions = Record<CaptionKey, [string, string]>;
	type Rect = { x: number; y: number; w: number; h: number };
	type Status = 'A' | 'M' | 'R';
	type FileType = 'ts' | 'json' | 'md' | 'env' | 'yaml';
	type Row = { id: string; d: number; n: string; dir?: boolean; open?: boolean; h?: boolean; st?: Status; p?: number; m?: number; ft?: FileType };
	type DiffLine = [' ' | '+' | '-' | '@', string];
	type EditorLine = { t: string; k: '' | 'typing' | 'add' | 'del' };

	// Playback speed of the whole scene; durations below are written at 1x.
	const SPEED = 2.58;
	const W = 1600;
	const H = 1000;
	const PATH = '~/.treehouse/f0-demo-3a91c/2/f0-demo';
	const PROMPT = 'Add retry with exponential backoff to fetchBalance and cover it with tests';
	const BRAILLE = '⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏';
	const STARS = '·✢✳✶✻✽✻✶✳✢';
	const CAPTION_STEP: Record<CaptionKey, number> = { overview: -1, agent: 0, editor: 1, changes: 2, explorer: 3, terminals: 4, dark: -1, done: -1 };
	const FILE_LABEL: Record<FileType, string> = { ts: 'TS', json: '{}', md: 'M↓', env: '*', yaml: 'Y' };

	const CHANGES: Row[] = [
		{ id: 'src', d: 0, n: 'src', dir: true },
		{ id: 'api', d: 1, n: 'api', dir: true },
		{ id: 'tests', d: 2, n: '__tests__', dir: true },
		{ id: 'wtest', d: 3, n: 'wallet.test.ts', st: 'A', p: 32 },
		{ id: 'wallet', d: 2, n: 'wallet.ts', st: 'M', p: 5, m: 2 },
		{ id: 'utils', d: 1, n: 'utils', dir: true },
		{ id: 'retry', d: 2, n: 'retry.ts', st: 'A', p: 16 },
	];

	const EXPLORER: Row[] = [
		{ id: 'expo', d: 0, n: '.expo', dir: true },
		{ id: 'github', d: 0, n: '.github', dir: true },
		{ id: 'app', d: 0, n: 'app', dir: true },
		{ id: 'assets', d: 0, n: 'assets', dir: true },
		{ id: 'nm', d: 0, n: 'node_modules', dir: true },
		{ id: 'src', d: 0, n: 'src', dir: true },
		{ id: 'api', d: 1, n: 'api', dir: true, h: true },
		{ id: 'tests', d: 2, n: '__tests__', dir: true, h: true, open: true },
		{ id: 'wtest', d: 3, n: 'wallet.test.ts', h: true, st: 'A' },
		{ id: 'http', d: 2, n: 'http.ts', h: true },
		{ id: 'wallet', d: 2, n: 'wallet.ts', h: true, st: 'M' },
		{ id: 'comp', d: 1, n: 'components', dir: true, h: true },
		{ id: 'hooks', d: 1, n: 'hooks', dir: true, h: true },
		{ id: 'fmtA', d: 2, n: 'format.ts', h: true },
		{ id: 'useb', d: 2, n: 'useBalance.ts', h: true },
		{ id: 'utils', d: 1, n: 'utils', dir: true, h: true },
		{ id: 'retry', d: 2, n: 'retry.ts', h: true, st: 'A' },
		{ id: 'env', d: 0, n: '.env.example', ft: 'env' },
		{ id: 'appjson', d: 0, n: 'app.json', ft: 'json' },
		{ id: 'pkg', d: 0, n: 'package.json', ft: 'json' },
		{ id: 'lock', d: 0, n: 'pnpm-lock.yaml', ft: 'yaml' },
		{ id: 'tsconfig', d: 0, n: 'tsconfig.json', ft: 'json' },
		{ id: 'readme', d: 0, n: 'README.md', ft: 'md' },
	];

	const ORIGINAL = [
		"import { http } from './http';",
		'',
		'type Balance = { amount: number; currency: string };',
		'',
		'export async function fetchBalance(id: string) {',
		'  const res = await http.get<Balance>(`/wallets/${id}`);',
		'  return res;',
		'}',
	];

	const WALLET_DIFF: DiffLine[] = [
		['@', '@@ -1,8 +1,11 @@'],
		[' ', "import { http } from './http';"],
		['+', "import { withRetry } from '../utils/retry';"],
		['@', '@@ export async function fetchBalance @@'],
		['-', '  const res = await http.get<Balance>(`/wallets/${id}`);'],
		['-', '  return res;'],
		['+', '  return withRetry('],
		['+', '    () => http.get<Balance>(`/wallets/${id}`),'],
		['+', '    { retries: 3, baseMs: 200 },'],
		['+', '  );'],
	];

	const RETRY_DIFF: DiffLine[] = [
		['@', '@@ -0,0 +1,16 @@'],
		['+', 'const sleep = (ms: number) =>'],
		['+', '  new Promise((r) => setTimeout(r, ms));'],
		['+', ''],
		['+', 'export async function withRetry<T>('],
		['+', '  fn: () => Promise<T>,'],
		['+', '  { retries = 3, baseMs = 200 } = {},'],
		['+', '): Promise<T> {'],
		['+', '  for (let i = 0; ; i++) {'],
		['+', '    try { return await fn(); }'],
		['+', '    catch (err) {'],
		['+', '      if (i >= retries) throw err;'],
		['+', '      await sleep(baseMs * 2 ** i);'],
	];

	const TERMINALS: [string, string, boolean][] = [
		['t1', 'server', true],
		['t2', 'test', true],
		['t3', 'typecheck', true],
		['t4', 'shell', false],
	];

	const SERVER_LOGS = ['[wallet] balance refreshed', '[auth] session ok', '[push] token registered', '[wallet] 3 movements synced', '[net] online'];

	const TOKEN = /(\/\/.*$)|(`[^`]*`?|'[^']*'?)|\b(import|from|export|type|async|function|return|await|const|let|new|throw|try|catch|for|if|of)\b|\b([A-Z]\w*)\b|\b([a-z_]\w*)(?=\s*[(<])|\b(\d+)\b/g;

	const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
	const now = () => new Date().toTimeString().slice(0, 8);

	function el(tag: string, cls: string, html?: string) {
		const e = document.createElement(tag);
		e.className = cls;
		if (html !== undefined) e.innerHTML = html;
		return e;
	}

	function highlight(src: string) {
		let out = '';
		let last = 0;
		TOKEN.lastIndex = 0;
		for (let m = TOKEN.exec(src); m; m = TOKEN.exec(src)) {
			if (!m[0]) {
				TOKEN.lastIndex++;
				continue;
			}
			const cls = m[1] ? 'c' : m[2] ? 's' : m[3] ? 'k' : m[4] ? 't' : m[5] ? 'f' : 'nu';
			out += esc(src.slice(last, m.index)) + `<span class="${cls}">${esc(m[0])}</span>`;
			last = TOKEN.lastIndex;
		}
		return out + esc(src.slice(last));
	}

	function rowHTML(r: Row, withCounts: boolean) {
		const pad = `<span style="width:${8 + r.d * 14}px;flex:none"></span>`;
		if (r.dir) return `${pad}<span class="chev">${r.open ? '▾' : '▸'}</span><span class="fold"></span><span class="dn nm">${r.n}</span>`;
		const ft = r.ft ?? 'ts';
		let right = '';
		if (withCounts && (r.p || r.m)) {
			right += `<span class="cnt">${r.p ? `<span class="g">+${r.p}</span>` : ''} ${r.m ? `<span class="r">-${r.m}</span>` : ''}</span>`;
		}
		if (r.st) right += `<span class="st st-${r.st}">${r.st}</span>`;
		return `${pad}<span class="ft ${ft}">${FILE_LABEL[ft]}</span><span class="nm ${r.st ? 'n-' + r.st : ''}">${r.n}</span>${right}`;
	}

	function createDemo(root: HTMLElement, captions: Captions) {
		const $ = (selector: string, scope: ParentNode = root) => scope.querySelector(selector) as HTMLElement;
		const panel = (id: string) => $(`[data-panel="${id}"]`);
		const stage = $('.stage');
		const world = $('.world');
		const cap = $('.cap');
		const outroEl = $('.outro');

		// The scene only advances while it is on screen: every pause waits for visibility before resolving.
		let visible = false;
		let started = false;
		const waiting: (() => void)[] = [];
		const awake = () => (visible ? Promise.resolve() : new Promise<void>((resolve) => waiting.push(resolve)));
		const hold = (ms: number) => new Promise<void>((resolve) => setTimeout(resolve, ms)).then(awake);
		const sleep = (ms: number) => hold(ms / SPEED);

		// CSS animations and transitions are authored at 1x too; infinite ones (cursor blink, pulse) keep their pace.
		const speedUp = () => {
			for (const animation of stage.getAnimations({ subtree: true })) {
				if (animation.effect?.getTiming().iterations !== Infinity) animation.playbackRate = SPEED;
			}
		};
		stage.addEventListener('animationstart', speedUp);
		stage.addEventListener('transitionrun', speedUp);

		/* camera */
		let cam = { x: 0, y: 0, z: 1 };
		const applyCam = () => {
			const f = stage.clientWidth / W;
			world.style.transform = `translate(${cam.x * f}px,${cam.y * f}px) scale(${cam.z * f})`;
		};
		const fitOutro = () => {
			$('.ovw').style.transform = `scale(${stage.clientWidth / W})`;
		};
		new ResizeObserver(() => {
			applyCam();
			fitOutro();
		}).observe(stage);

		function tweenCam(to: typeof cam, duration: number) {
			return new Promise<void>((resolve) => {
				const dur = duration / SPEED;
				const from = { ...cam };
				const t0 = performance.now();
				const step = () => {
					const k = Math.min(1, (performance.now() - t0) / dur);
					const e = k < 0.5 ? 4 * k * k * k : 1 - Math.pow(-2 * k + 2, 3) / 2;
					cam = { x: from.x + (to.x - from.x) * e, y: from.y + (to.y - from.y) * e, z: from.z + (to.z - from.z) * e };
					applyCam();
					if (k < 1) requestAnimationFrame(step);
					else resolve();
				};
				requestAnimationFrame(step);
			});
		}

		function rectOf(e: HTMLElement): Rect {
			let x = 0;
			let y = 0;
			for (let n: Element | null = e; n instanceof HTMLElement && n !== world; n = n.offsetParent) {
				x += n.offsetLeft;
				y += n.offsetTop;
			}
			return { x, y, w: e.offsetWidth, h: e.offsetHeight };
		}

		// Part of a panel: `top` counts from the bottom when negative.
		function regionOf(id: string, top: number, h?: number): Rect {
			const r = rectOf(panel(id));
			const y = top >= 0 ? r.y + top : r.y + r.h + top;
			return { x: r.x, y, w: r.w, h: h ?? r.y + r.h - y };
		}

		async function focusOn(ids: string[], region?: Rect) {
			const rs = region ? [region] : ids.map((id) => rectOf(panel(id)));
			const x0 = Math.min(...rs.map((r) => r.x));
			const y0 = Math.min(...rs.map((r) => r.y));
			const w = Math.max(...rs.map((r) => r.x + r.w)) - x0;
			const h = Math.max(...rs.map((r) => r.y + r.h)) - y0;
			for (const p of root.querySelectorAll<HTMLElement>('.panel')) p.classList.toggle('focus', ids.includes(p.dataset.panel ?? ''));
			world.classList.add('zoomed');
			const z = Math.max(1, Math.min(Math.min(W / w, H / h) * 0.92, 3.2));
			const x = Math.min(0, Math.max(W - W * z, W / 2 - (x0 + w / 2) * z));
			const y = Math.min(0, Math.max(H - H * z, H / 2 - (y0 + h / 2) * z));
			await tweenCam({ x, y, z }, 1200);
		}

		async function overview() {
			world.classList.remove('zoomed');
			for (const p of root.querySelectorAll('.panel.focus')) p.classList.remove('focus');
			await tweenCam({ x: 0, y: 0, z: 1 }, 1200);
		}

		async function setTheme(dark: boolean) {
			world.style.opacity = '0';
			await sleep(320);
			stage.classList.toggle('dark', dark);
			world.style.opacity = '1';
			await sleep(350);
		}

		/* caption */
		function renderCaption(key: CaptionKey) {
			const [label, text] = captions[key];
			const dots = [0, 1, 2, 3, 4].map((j) => `<i class="${j === CAPTION_STEP[key] ? 'on' : ''}"></i>`).join('');
			cap.innerHTML = `<span><b>${esc(label)}</b> · ${esc(text)}</span><span class="dots">${dots}</span>`;
			cap.classList.remove('hide');
		}

		async function caption(key: CaptionKey) {
			cap.classList.add('hide');
			await sleep(250);
			renderCaption(key);
		}

		/* changes */
		const changeRows: Record<string, HTMLElement> = {};
		function buildChanges() {
			const p = panel('changes');
			p.innerHTML = `<div class="ph o">changes</div><div class="chlist"></div><div class="clean dim">✓ working tree clean</div>`;
			const list = $('.chlist', p);
			for (const r of CHANGES) {
				const e = el('div', 'row hidden', rowHTML({ ...r, open: true }, true));
				changeRows[r.id] = e;
				list.appendChild(e);
			}
		}
		function showChanges(ids: string[]) {
			$('.clean', panel('changes')).style.display = 'none';
			for (const id of ids) {
				const e = changeRows[id];
				if (!e.classList.contains('hidden')) continue;
				e.classList.remove('hidden');
				e.classList.add(CHANGES.find((r) => r.id === id)?.dir ? 'enter' : 'flash');
			}
		}
		function selectChange(id: string) {
			for (const e of Object.values(changeRows)) e.classList.remove('sel', 'flash', 'enter');
			changeRows[id].classList.add('sel');
		}

		/* explorer */
		const explorerRows: Record<string, HTMLElement> = {};
		function buildExplorer() {
			const p = panel('explorer');
			p.innerHTML = `<div class="ph dim">explorer</div><div class="exlist"></div>`;
			const list = $('.exlist', p);
			for (const r of EXPLORER) {
				const e = el('div', 'row' + (r.h ? ' hidden' : ''), rowHTML(r, false));
				if (r.id === 'nm') e.style.opacity = '0.5';
				explorerRows[r.id] = e;
				list.appendChild(e);
			}
		}
		function selectExplorer(id: string) {
			for (const e of Object.values(explorerRows)) e.classList.remove('sel');
			explorerRows[id].classList.add('sel');
		}
		async function expand(id: string, kids: string[], fresh: string[] = []) {
			$('.chev', explorerRows[id]).textContent = '▾';
			for (const k of kids) {
				const e = explorerRows[k];
				e.classList.remove('hidden', 'flash', 'enter');
				void e.offsetWidth;
				e.classList.add(fresh.includes(k) ? 'flash' : 'enter');
				await sleep(80);
			}
		}

		/* editor */
		const ed: { lines: EditorLine[]; cur: { l: number; c: number }; mode: 'NORMAL' | 'INSERT' } = {
			lines: [],
			cur: { l: 0, c: 0 },
			mode: 'NORMAL',
		};
		const mode = $('.mode');
		const command = (html: string) => {
			$('.ecmd', panel('editor')).innerHTML = html;
		};
		function setMode(next: 'NORMAL' | 'INSERT') {
			mode.textContent = next;
			mode.className = 'mode' + (next === 'INSERT' ? ' ins' : '');
		}
		function buildEditor() {
			panel('editor').innerHTML = `<div class="tabs"><span class="tab">[No Name]</span></div><div class="ebody"><div class="splash">space ff &nbsp;<span class="hint">find file</span></div></div><div class="ecmd"></div>`;
			ed.lines = [];
			ed.cur = { l: 0, c: 0 };
			ed.mode = 'NORMAL';
			setMode('NORMAL');
			$('.stfile').textContent = '';
			$('.pos').textContent = '1:1';
		}
		function renderEditor() {
			let h = '';
			ed.lines.forEach((ln, i) => {
				const cur = i === ed.cur.l;
				let code = highlight(ln.t);
				if (cur) {
					const c = ed.cur.c;
					const at = ed.mode === 'INSERT' ? '<span class="bar"></span>' + highlight(ln.t.slice(c)) : `<span class="blk">${esc(ln.t[c] || ' ')}</span>` + highlight(ln.t.slice(c + 1));
					code = highlight(ln.t.slice(0, c)) + at;
				}
				h += `<div class="ln ${ln.k} ${cur ? 'cl' : ''}"><span class="gs"></span><span class="num">${cur ? i + 1 : Math.abs(i - ed.cur.l)}</span><span class="code">${code}</span></div>`;
			});
			h += '<div class="tilde">~</div>'.repeat(16);
			$('.ebody', panel('editor')).innerHTML = h;
			setMode(ed.mode);
			$('.pos').textContent = `${ed.cur.l + 1}:${ed.cur.c + 1}`;
		}
		function openFile() {
			ed.lines = ORIGINAL.map((t) => ({ t, k: '' }));
			ed.cur = { l: 0, c: 0 };
			$('.tabs', panel('editor')).innerHTML = '<span class="tab on">wallet.ts</span>';
			$('.stfile').textContent = 'src/api/wallet.ts';
			command('<span class="dim">"src/api/wallet.ts" 8L, 241B</span>');
			renderEditor();
		}
		async function move(l: number, c: number, d = 200) {
			ed.cur = { l, c };
			renderEditor();
			await sleep(d);
		}
		async function typeLine(at: number, text: string) {
			ed.lines.splice(at, 0, { t: '', k: 'typing' });
			ed.cur = { l: at, c: 0 };
			renderEditor();
			for (let i = 1; i <= text.length; i++) {
				ed.lines[at].t = text.slice(0, i);
				ed.cur.c = i;
				renderEditor();
				await sleep(text[i - 1] === ' ' ? 12 : 24 + Math.random() * 34);
			}
			ed.lines[at].k = 'add';
		}
		async function showDiff(file: string, lines: DiffLine[], speed: number) {
			$('.tabs', panel('editor')).innerHTML = `<span class="tab on">${file.split('/').pop()} <span class="dim">(diff)</span></span>`;
			$('.stfile').textContent = file;
			command(`<span class="dim">${esc(file)}</span>`);
			setMode('NORMAL');
			const body = $('.ebody', panel('editor'));
			body.innerHTML = '';
			for (const [k, text] of lines) {
				const cls = k === '+' ? 'a' : k === '-' ? 'd' : k === '@' ? 'h' : '';
				body.appendChild(el('div', 'dl ' + cls, k === '@' ? esc(text) : esc(k + ' ') + highlight(text)));
				await sleep(speed);
			}
		}
		async function editorScene() {
			await move(0, 0, 300);
			await move(0, 29, 350);
			command('<span class="dim">o</span>');
			await sleep(250);
			ed.mode = 'INSERT';
			command('<span class="g strong">-- INSERT --</span>');
			await typeLine(1, "import { withRetry } from '../utils/retry';");
			ed.mode = 'NORMAL';
			command('');
			renderEditor();
			await sleep(400);
			await move(3, 0, 150);
			await move(5, 0, 150);
			await move(6, 2, 300);
			command('<span class="dim">2dd</span>');
			ed.lines[6].k = 'del';
			ed.lines[7].k = 'del';
			renderEditor();
			await sleep(900);
			ed.lines.splice(6, 2);
			ed.cur = { l: 6, c: 0 };
			renderEditor();
			await sleep(250);
			command('<span class="dim">O</span>');
			await sleep(200);
			ed.mode = 'INSERT';
			command('<span class="g strong">-- INSERT --</span>');
			await typeLine(6, '  return withRetry(');
			await typeLine(7, '    () => http.get<Balance>(`/wallets/${id}`),');
			await typeLine(8, '    { retries: 3, baseMs: 200 },');
			await typeLine(9, '  );');
			ed.mode = 'NORMAL';
			ed.cur.c = 3;
			renderEditor();
			command('');
			await sleep(350);
			command(':');
			await sleep(200);
			command(':w');
			await sleep(350);
			command('<span class="dim">"src/api/wallet.ts" 11L, 318B written</span>');
		}

		/* agent */
		function say(html: string, cls = '') {
			const log = $('.alog', panel('agent'));
			const b = el('div', 'ab ' + cls, html);
			log.appendChild(b);
			while (log.children.length > 24) log.firstElementChild?.remove();
			return b;
		}
		function tool(name: string, arg: string) {
			return say(`<div><span class="dot run">●</span> <b>${name}</b>(${esc(arg)})</div><div class="res dim">  ⎿  <span class="spin">⠋</span> running…</div>`);
		}
		function done(b: HTMLElement, html: string) {
			$('.dot', b).className = 'dot ok';
			$('.res', b).innerHTML = '  ⎿  ' + html;
		}
		function buildAgent() {
			panel('agent').innerHTML = `<div class="ph dim">agent: claude</div><div class="alog"></div>
				<div class="ain"><span class="pmt">❯</span> <span class="ait"></span><span class="tcur"></span></div>
				<div class="afoot"><span class="o">⏵⏵ auto mode on</span><span class="dim">(shift+tab to cycle)</span></div>`;
			say(`<div>&gt; Where is fetchBalance used?</div>`, 'user');
			say(`<div><span class="dot ok">●</span> <b>Search</b>(pattern: "fetchBalance", path: "src")</div><div class="dim">  ⎿  Found 3 files</div>`);
			say(`<div class="wrap"><span class="dot msg">●</span> It's called from useBalance.ts, WalletScreen.tsx and the pull-to-refresh handler in HomeScreen.tsx.</div>`);
			say(`<div class="dim"><span class="o">✻</span> Brewed for 6s</div>`);
		}

		/* terminals */
		function line(id: string, html: string, animate = false) {
			const b = $('.tb', panel(id));
			const d = el('div', 'tl' + (animate ? ' enter' : ''), html);
			b.appendChild(d);
			while (b.children.length > 30) b.firstElementChild?.remove();
			return d;
		}
		function run(id: string, c: string) {
			line(id, `<span class="dim">${PATH}</span>`);
			line(id, `<span class="pr">▶</span> ${esc(c)}`);
		}
		function buildTerminals() {
			for (const [id, name, running] of TERMINALS) {
				panel(id).innerHTML = `<div class="th">${name}${running ? '<span class="run"><i class="pulse"></i>running</span>' : ''}</div><div class="tb"></div>`;
			}
			run('t1', 'pnpm expo start');
			line('t1', 'Starting Metro Bundler');
			line('t1', '› Metro waiting on <span class="bl">exp://192.168.0.12:8081</span>');
			line('t1', '› Press <b>i</b> │ open iOS simulator');
			line('t1', '› Press <b>r</b> │ reload app');
			line('t1', '<span class="g">iOS Bundled</span> 1834ms index.ts <span class="dim">(1,203 modules)</span>');
			line('t1', ' <span class="lg">LOG</span>  [wallet] balance refreshed <span class="dim">812ms</span>');
			run('t2', 'pnpm jest --watch');
			line('t2', '<span class="dim">No tests found related to files changed since last commit.</span>');
			line('t2', '<span class="dim">Watch Usage: Press <b>w</b> to show more.</span>');
			run('t3', 'pnpm tsc --noEmit --watch');
			line('t3', `<span class="dim">[${now()}]</span> Starting compilation in watch mode...`);
			line('t3', `<span class="dim">[${now()}]</span> Found <span class="g">0 errors</span>. Watching for file changes.`);
			line('t4', `<span class="dim">${PATH}</span>`);
			line('t4', '<span class="pr">▶</span> <span class="tcur"></span>');
		}
		async function bundle() {
			const d = line('t1', '<span class="spin">⠋</span> iOS Bundling <span class="pc">0%</span> <span class="dim">index.ts</span>', true);
			for (const p of [9, 31, 58, 84, 100]) {
				$('.pc', d).textContent = p + '%';
				await sleep(170);
			}
			d.innerHTML = '<span class="g">iOS Bundled</span> 214ms index.ts <span class="dim">(1,204 modules)</span>';
		}
		async function typecheck() {
			line('t3', `<span class="dim">[${now()}]</span> File change detected. Starting incremental compilation...`, true);
			await sleep(1300);
			line('t3', `<span class="dim">[${now()}]</span> Found <span class="g">0 errors</span>. Watching for file changes.`, true);
		}
		async function testRun() {
			line('t2', '<span class="dim">Determining test suites to run...</span>', true);
			await sleep(600);
			const r = line('t2', '<span class="badge runs">RUNS</span> src/api/__tests__/wallet.test.ts <span class="spin">⠋</span>', true);
			await sleep(1800);
			r.innerHTML = '<span class="badge pass">PASS</span> src/api/__tests__/wallet.test.ts';
			const output = [
				'  fetchBalance',
				'    <span class="g">✓</span> returns the balance on first try <span class="dim">(3 ms)</span>',
				'    <span class="g">✓</span> retries on 503 and succeeds <span class="dim">(204 ms)</span>',
				'    <span class="g">✓</span> backs off 200 → 400 → 800 ms <span class="dim">(2 ms)</span>',
				'    <span class="g">✓</span> gives up after 3 retries <span class="dim">(5 ms)</span>',
				'',
				'<b>Tests:</b>       <span class="g">4 passed</span>, 4 total',
				'<b>Time:</b>        1.21 s',
			];
			for (const l of output) {
				await sleep(220);
				line('t2', l, true);
			}
		}
		async function shellScene() {
			$('.tb', panel('t4')).lastElementChild?.remove();
			const prompt = line('t4', '<span class="pr">▶</span> <span class="v"></span><span class="tcur"></span>');
			const v = $('.v', prompt);
			const c = 'git diff --stat';
			for (let i = 1; i <= c.length; i++) {
				v.textContent = c.slice(0, i);
				await sleep(70 + Math.random() * 50);
			}
			await sleep(300);
			$('.tcur', prompt).remove();
			const output = [
				' src/api/__tests__/wallet.test.ts | 32 <span class="g">++++++++++</span>',
				' src/api/wallet.ts                |  7 <span class="g">+++++</span><span class="r">--</span>',
				' src/utils/retry.ts               | 16 <span class="g">+++++</span>',
				' 3 files changed, 53 insertions(+), 2 deletions(-)',
			];
			for (const o of output) {
				await sleep(130);
				line('t4', o, true);
			}
			line('t4', `<span class="dim">${PATH}</span>`);
			line('t4', '<span class="pr">▶</span> <span class="tcur"></span>');
		}

		/* scenario */
		function reset() {
			stage.classList.remove('dark');
			outroEl.classList.remove('on', 'dom');
			buildChanges();
			buildExplorer();
			buildEditor();
			buildAgent();
			buildTerminals();
		}

		async function outro() {
			cap.classList.add('hide');
			outroEl.classList.add('on');
			await hold(1200);
			outroEl.classList.add('dom');
			await hold(2200);
		}

		async function scene() {
			world.style.opacity = '0';
			outroEl.classList.remove('on');
			await sleep(550);
			reset();
			world.style.opacity = '1';
			caption('overview');
			await sleep(2800);

			caption('agent');
			await focusOn(['agent'], regionOf('agent', -340));
			await sleep(500);
			const input = $('.ait', panel('agent'));
			for (let i = 1; i <= PROMPT.length; i++) {
				input.textContent = PROMPT.slice(0, i);
				await sleep(PROMPT[i - 1] === ' ' ? 40 : 28 + Math.random() * 40);
			}
			await sleep(450);
			input.textContent = '';
			say(`<div>&gt; ${PROMPT}</div>`, 'user');
			const thinking = say(`<div><span class="star">✻</span> <span class="o">Thinking…</span> <span class="dim">(esc to interrupt)</span></div>`);
			await sleep(1700);
			thinking.remove();
			const read = tool('Read', 'src/api/wallet.ts');
			await sleep(600);
			done(read, 'Read 8 lines');
			openFile();
			await sleep(500);
			const update = tool('Update', 'src/api/wallet.ts');
			await sleep(700);

			caption('editor');
			await focusOn(['editor'], regionOf('editor', 0, 310));
			await editorScene();
			done(update, 'Updated src/api/wallet.ts with 5 additions and 2 removals');
			say(
				`<div class="mini">      2 <span class="a">+ import { withRetry } from '../utils/retry';</span></div>` +
					`<div class="mini">      7 <span class="d">-   const res = await http.get&lt;Balance&gt;(\`/wallets/\${id}\`);</span></div>` +
					`<div class="mini">      7 <span class="a">+   return withRetry(</span></div>`,
			);
			showChanges(['src', 'api', 'wallet']);
			bundle();
			typecheck();
			const writes = (async () => {
				const retry = tool('Write', 'src/utils/retry.ts');
				await sleep(800);
				done(retry, 'Wrote 16 lines to src/utils/retry.ts');
				showChanges(['utils', 'retry']);
				await sleep(600);
				const test = tool('Write', 'src/api/__tests__/wallet.test.ts');
				await sleep(900);
				done(test, 'Wrote 32 lines to src/api/__tests__/wallet.test.ts');
				showChanges(['tests', 'wtest']);
				typecheck();
			})();
			await sleep(900);

			caption('changes');
			await focusOn(['changes'], regionOf('changes', 0, 250));
			await writes;
			await sleep(500);
			selectChange('wallet');
			await sleep(500);
			let diff = showDiff('src/api/wallet.ts', WALLET_DIFF, 160);
			await focusOn(['editor'], regionOf('editor', 0, 310));
			await diff;
			await sleep(1300);
			await focusOn(['changes'], regionOf('changes', 0, 250));
			selectChange('retry');
			await sleep(500);
			diff = showDiff('src/utils/retry.ts', RETRY_DIFF, 130);
			await focusOn(['editor'], regionOf('editor', 0, 310));
			await diff;
			await sleep(1200);

			caption('dark');
			await overview();
			await sleep(400);
			await setTheme(true);
			await sleep(1600);

			caption('explorer');
			const explorer = rectOf(panel('explorer'));
			const src = rectOf(explorerRows.src);
			await focusOn(['explorer'], { x: explorer.x, w: explorer.w, y: src.y - 10, h: 300 });
			selectExplorer('src');
			await sleep(450);
			await expand('src', ['api', 'comp', 'hooks', 'utils']);
			await sleep(400);
			selectExplorer('api');
			await sleep(400);
			await expand('api', ['tests', 'wtest', 'http', 'wallet'], ['tests', 'wtest']);
			await sleep(600);
			selectExplorer('utils');
			await sleep(400);
			await expand('utils', ['retry'], ['retry']);
			await sleep(600);
			selectExplorer('hooks');
			await sleep(400);
			await expand('hooks', ['fmtA', 'useb']);
			await sleep(500);
			selectExplorer('retry');
			await sleep(600);
			selectExplorer('wtest');
			await sleep(1200);

			const jest = tool('Bash', 'pnpm jest wallet');
			caption('terminals');
			await focusOn(['t1']);
			bundle();
			await sleep(1600);
			await focusOn(['t2']);
			await testRun();
			done(jest, '<span class="g">PASS</span> · 4 tests passed');
			await sleep(900);
			await focusOn(['t3']);
			await typecheck();
			await sleep(600);
			await focusOn(['t4']);
			await shellScene();
			await sleep(1500);

			say(
				`<div class="wrap"><span class="dot msg">●</span> fetchBalance now retries up to 3 times with exponential backoff (200 → 400 → 800 ms). Added withRetry in src/utils/retry.ts and 4 tests in wallet.test.ts, all passing.</div>`,
			);
			say(`<div class="dim"><span class="o">✻</span> Brewed for 26s</div>`);
			caption('done');
			await overview();
			await sleep(2600);
			await outro();
		}

		function start() {
			let tick = 0;
			setInterval(() => {
				if (!visible) return;
				tick++;
				for (const s of root.querySelectorAll('.spin')) s.textContent = BRAILLE[tick % BRAILLE.length];
				if (tick % 2) for (const s of root.querySelectorAll('.star')) s.textContent = STARS[(tick >> 1) % STARS.length];
			}, 90);
			let log = 0;
			setInterval(() => {
				if (!visible) return;
				const ms = 200 + Math.floor(Math.random() * 700);
				line('t1', ` <span class="lg">LOG</span>  ${SERVER_LOGS[log++ % SERVER_LOGS.length]} <span class="dim">${ms}ms</span>`, true);
			}, 3600);
			(async () => {
				while (true) {
					try {
						await scene();
					} catch (error) {
						console.error(error);
						await sleep(1000);
					}
				}
			})();
		}

		reset();
		fitOutro();
		applyCam();

		return {
			still() {
				renderCaption('overview');
			},
			setVisible(next: boolean) {
				visible = next;
				if (!next) return;
				for (const resolve of waiting.splice(0)) resolve();
				if (!started) {
					started = true;
					start();
				}
			},
		};
	}

	class Showcase extends HTMLElement {
		connectedCallback() {
			const captions = JSON.parse(this.dataset.captions ?? '{}') as Captions;
			const demo = createDemo(this, captions);
			if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
				demo.still();
				return;
			}
			new IntersectionObserver(([entry]) => demo.setVisible(entry?.isIntersecting ?? false), { threshold: 0.25 }).observe(this);
		}
	}

	customElements.define('f0-showcase', Showcase);
</script>

