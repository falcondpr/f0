---
import { Image } from 'astro:assets';
import workspace from '../assets/workspace.png';

const copy = {
	en: {
		alt: 'An f0 workspace for task F0-123 of an Expo app: Neovim with the changed files and the explorer, Claude Code on the right, and the Expo server plus three shells in the bottom row.',
		tour: 'Workspace areas',
		intro: 'Every task opens in this layout. Pick an area to see what it does.',
		regions: {
			editor: ['Editor', 'Neovim in the worktree: changed files on the left, the file or a side-by-side diff in the middle, the explorer on the right.'],
			agent: ['Agent', 'Your AI agent, already inside the task. Claude Code here, or Codex or any other CLI you set in the config.'],
			servers: ['Servers', 'Dev servers from the project config. Each one waits for Enter, unless you start it with --start or autostart.'],
			shells: ['Terminals', 'Shells in the same worktree, for git, tests or anything else.'],
		},
	},
	es: {
		alt: 'Un espacio de trabajo de f0 para la tarea F0-123 de una app de Expo: Neovim con los archivos modificados y el explorador, Claude Code a la derecha, y el servidor de Expo más tres shells en la fila de abajo.',
		tour: 'Áreas del espacio de trabajo',
		intro: 'Cada tarea se abre con este layout. Elegí un área para ver qué hace.',
		regions: {
			editor: ['Editor', 'Neovim en el worktree: archivos modificados a la izquierda, el archivo o un diff lado a lado en el medio, el explorador a la derecha.'],
			agent: ['Agente', 'Tu agente de IA, ya dentro de la tarea. Acá Claude Code, o Codex o cualquier otra CLI que configures.'],
			servers: ['Servidores', 'Los servidores del proyecto. Cada uno espera un Enter, salvo que lo arranques con --start o autostart.'],
			shells: ['Terminales', 'Shells en el mismo worktree, para git, tests o lo que necesites.'],
		},
	},
};

const t = copy[Astro.currentLocale === 'es' ? 'es' : 'en'];
const regions = Object.entries(t.regions) as [string, [string, string]][];
---

<f0-showcase class="not-content">
	<div class="window">
		<div class="titlebar" aria-hidden="true">
			<span></span><span></span><span></span>
			<p>f0-demo/F0-123</p>
		</div>
		<div class="screen">
			<Image src={workspace} alt={t.alt} widths={[800, 1200, 2000]} sizes="(min-width: 72rem) 68rem, 100vw" loading="eager" />
			{regions.map(([id]) => <div class="region" data-region={id} aria-hidden="true"></div>)}
		</div>
	</div>
	<div class="tour" role="group" aria-label={t.tour}>
		{
			regions.map(([id, [label]]) => (
				<button type="button" data-region={id} aria-pressed="false">
					{label}
				</button>
			))
		}
	</div>
	<p class="caption" aria-live="polite" data-intro={t.intro}>{t.intro}</p>
	<template>
		{regions.map(([id, [, text]]) => <span data-region={id}>{text}</span>)}
	</template>
</f0-showcase>

<script>
	const TOUR_STEP_MS = 3500;

	class Showcase extends HTMLElement {
		#timer: number | undefined;
		#touched = false;

		connectedCallback() {
			const buttons = [...this.querySelectorAll<HTMLButtonElement>('.tour button')];
			const regions = this.querySelectorAll<HTMLElement>('.region');

			for (const button of buttons) {
				button.addEventListener('click', () => this.#pick(button.dataset.region));
				button.addEventListener('mouseenter', () => this.#pick(button.dataset.region));
				button.addEventListener('focus', () => this.#pick(button.dataset.region));
			}
			for (const region of regions) {
				region.addEventListener('mouseenter', () => this.#pick(region.dataset.region));
			}
			this.querySelector('.screen')?.addEventListener('mouseleave', () => this.#pick(undefined));

			if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
			// The tour only runs while the screenshot is on screen, and stops for good once the reader takes over.
			new IntersectionObserver(([entry]) => {
				if (entry?.isIntersecting && !this.#touched) this.#play(buttons);
				else this.#stop();
			}, { threshold: 0.5 }).observe(this);
		}

		#play(buttons: HTMLButtonElement[]) {
			if (this.#timer !== undefined) return;
			let step = 0;
			const next = () => {
				this.#show(buttons[step % buttons.length]?.dataset.region);
				step++;
			};
			next();
			this.#timer = window.setInterval(next, TOUR_STEP_MS);
		}

		#stop() {
			window.clearInterval(this.#timer);
			this.#timer = undefined;
		}

		#pick(id: string | undefined) {
			this.#touched = true;
			this.#stop();
			this.#show(id);
		}

		#show(id: string | undefined) {
			if (id) this.dataset.active = id;
			else delete this.dataset.active;
			for (const button of this.querySelectorAll<HTMLButtonElement>('.tour button')) {
				button.setAttribute('aria-pressed', String(button.dataset.region === id));
			}
			const caption = this.querySelector<HTMLElement>('.caption');
			const text = this.querySelector('template')?.content.querySelector(`[data-region="${id}"]`);
			if (caption) caption.textContent = text?.textContent ?? caption.dataset.intro ?? '';
		}
	}

	customElements.define('f0-showcase', Showcase);
</script>

<style>
	f0-showcase {
		display: block;
		margin-block: 1rem 3rem;
	}

	.window {
		overflow: hidden;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 0.75rem;
		background: #fff;
		box-shadow: 0 24px 60px rgb(0 0 0 / 0.16);
	}

	.titlebar {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		padding: 0.6rem 0.9rem;
		border-bottom: 1px solid var(--sl-color-hairline-light);
		background: var(--f0-surface);
	}

	.titlebar span {
		width: 0.7rem;
		height: 0.7rem;
		border-radius: 50%;
		background: #ff5f57;
	}

	.titlebar span:nth-child(2) {
		background: #febc2e;
	}

	.titlebar span:nth-child(3) {
		background: #28c840;
	}

	.titlebar p {
		flex: 1;
		margin: 0 3.4rem 0 0;
		color: var(--sl-color-gray-3);
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-xs);
		text-align: center;
	}

	.screen {
		position: relative;
		overflow: hidden;
	}

	.screen img {
		display: block;
		width: 100%;
		height: auto;
		margin: 0;
	}

	/* Coordinates of each tmux pane, as a share of the screenshot. */
	.region {
		position: absolute;
		margin: 0;
		border-radius: 0.375rem;
		transition: box-shadow 0.35s ease, outline-color 0.35s ease;
		outline: 2px solid transparent;
		outline-offset: -2px;
	}

	.region[data-region='editor'] {
		inset: 0.4% 35.4% 28.4% 0.4%;
	}

	.region[data-region='agent'] {
		inset: 0.4% 0.4% 26.9% 64.6%;
	}

	.region[data-region='servers'] {
		inset: 72.6% 74.8% 3.8% 0.4%;
	}

	.region[data-region='shells'] {
		inset: 72.6% 0.4% 3.8% 25.2%;
	}

	/* A huge spread shadow dims everything around the active pane; .screen clips it. */
	f0-showcase[data-active='editor'] .region[data-region='editor'],
	f0-showcase[data-active='agent'] .region[data-region='agent'],
	f0-showcase[data-active='servers'] .region[data-region='servers'],
	f0-showcase[data-active='shells'] .region[data-region='shells'] {
		box-shadow: 0 0 0 200vmax rgb(15 23 42 / 0.55);
		outline-color: var(--sl-color-accent);
	}

	.tour {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
		margin-top: 1.25rem;
	}

	.tour button {
		padding: 0.35rem 0.9rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 999px;
		background: var(--f0-surface);
		color: var(--sl-color-gray-2);
		font: inherit;
		font-size: var(--sl-text-sm);
		cursor: pointer;
		transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
	}

	.tour button[aria-pressed='true'] {
		border-color: var(--sl-color-accent);
		background: var(--sl-color-accent);
		color: var(--sl-color-text-invert);
	}

	.caption {
		min-height: 3em;
		max-width: 40rem;
		margin: 0.75rem auto 0;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-sm);
		text-align: center;
	}

	@media (prefers-reduced-motion: no-preference) {
		@supports (animation-timeline: view()) {
			.window {
				animation: straighten linear both;
				animation-timeline: view();
				animation-range: entry 0% cover 35%;
			}
		}
	}

	@keyframes straighten {
		from {
			transform: perspective(1800px) rotateX(14deg) scale(0.94);
		}
		to {
			transform: none;
		}
	}
</style>
