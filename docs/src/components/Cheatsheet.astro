const t = copy[Astro.currentLocale === 'es' ? 'es' : 'en'];
---

<script is:inline>
	// Before the first paint, so a page opened in zen mode does not flash the header.
	if (localStorage.getItem('f0-cheatsheet-zen') === 'on') document.documentElement.dataset.f0Zen = '';
</script>

<f0-cheatsheet class="not-content" data-zen-label={t.zen} data-exit-label={t.exitZen}>
	<div class="toolbar">
		<label class="filter">
			<span class="sr-only">{t.filter}</span>
			<input type="search" placeholder={t.placeholder} autocomplete="off" spellcheck="false" />
			<kbd aria-hidden="true">/</kbd>
		</label>
		<button type="button" class="zen" aria-pressed="false">
			<span>{t.zen}</span>
			<kbd aria-hidden="true">z</kbd>
		</button>
	</div>
	<p class="hint">{t.hint}</p>

	<div class="grid">
		{
			t.groups.map((group) => (
				<section>
					<header>
						<h2>{group.title}</h2>
						<a href={group.more}>{t.more}</a>
					</header>
					<dl>
						{group.rows.map((row) => (
							<div class="row">
								<dt>
									{row.cmd ? (
										<code>{row.cmd}</code>
									) : (
										row.keys?.map((key) => <kbd>{key}</kbd>)
									)}
								</dt>
								<dd>{row.text}</dd>
							</div>
						))}
					</dl>
				</section>
			))
		}
	</div>
	<p class="empty" hidden>{t.empty}</p>
</f0-cheatsheet>

<script>
	const ZEN_KEY = 'f0-cheatsheet-zen';

	class Cheatsheet extends HTMLElement {
		connectedCallback() {
			const input = this.querySelector<HTMLInputElement>('input');
			const zen = this.querySelector<HTMLButtonElement>('.zen');
			if (!input || !zen) return;

			input.addEventListener('input', () => this.#filter(input.value));
			zen.addEventListener('click', () => this.#setZen(!this.#isZen()));
			this.#setZen(this.#isZen());

			window.addEventListener('keydown', (e) => {
				if (e.metaKey || e.ctrlKey || e.altKey) return;
				if (e.target === input) {
					if (e.key === 'Escape') {
						input.value = '';
						this.#filter('');
						input.blur();
					}
					return;
				}
				// Leave keys alone while the reader types anywhere else, like the search dialog.
				if (e.target instanceof HTMLElement && e.target.closest('input, textarea, select, [contenteditable], dialog')) return;
				if (e.key === '/') {
					e.preventDefault();
					input.focus();
				} else if (e.key === 'z') {
					this.#setZen(!this.#isZen());
				} else if (e.key === 'Escape' && this.#isZen()) {
					this.#setZen(false);
				}
			});
		}

		#isZen() {
			return document.documentElement.dataset.f0Zen !== undefined;
		}

		#setZen(on: boolean) {
			const zen = this.querySelector<HTMLButtonElement>('.zen');
			const label = zen?.querySelector('span');
			if (on) document.documentElement.dataset.f0Zen = '';
			else delete document.documentElement.dataset.f0Zen;
			localStorage.setItem(ZEN_KEY, on ? 'on' : 'off');
			zen?.setAttribute('aria-pressed', String(on));
			if (label) label.textContent = (on ? this.dataset.exitLabel : this.dataset.zenLabel) ?? '';
		}

		#filter(query: string) {
			const words = query.toLowerCase().split(/\s+/).filter(Boolean);
			let shown = 0;
			for (const section of this.querySelectorAll('section')) {
				let rows = 0;
				for (const row of section.querySelectorAll<HTMLElement>('.row')) {
					const text = `${section.querySelector('h2')?.textContent} ${row.textContent}`.toLowerCase();
					const match = words.every((word) => text.includes(word));
					row.hidden = !match;
					if (match) rows++;
				}
				section.hidden = rows === 0;
				shown += rows;
			}
			const empty = this.querySelector<HTMLElement>('.empty');
			if (empty) empty.hidden = shown > 0;
		}
	}

	customElements.define('f0-cheatsheet', Cheatsheet);
</script>

<style>
	f0-cheatsheet {
		display: block;
		margin-top: 0.5rem;
	}

	.toolbar {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}

	.filter {
		position: relative;
		flex: 1 1 10rem;
	}

	.filter input {
		width: 100%;
		height: 2.5rem;
		padding: 0 2.5rem 0 0.9rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 0.75rem;
		background: var(--f0-surface);
		color: var(--sl-color-white);
		font: inherit;
		font-size: var(--sl-text-sm);
	}

	.filter input:focus {
		outline: 2px solid var(--sl-color-accent);
		outline-offset: -1px;
	}

	.filter kbd {
		position: absolute;
		inset-block: 0;
		inset-inline-end: 0.6rem;
		margin-block: auto;
		height: fit-content;
	}

	.zen {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		height: 2.5rem;
		padding: 0 0.9rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 0.75rem;
		background: var(--f0-surface);
		color: var(--sl-color-gray-2);
		font: inherit;
		font-size: var(--sl-text-sm);
		cursor: pointer;
	}

	.zen:hover,
	.zen[aria-pressed='true'] {
		border-color: var(--sl-color-gray-4);
		color: var(--sl-color-white);
	}

	.hint {
		margin: 0.6rem 0 0;
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(min(100%, 26rem), 1fr));
		gap: 1rem;
		margin-top: 1.5rem;
	}

	section {
		padding: 1rem 1.1rem 0.6rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-radius: 0.75rem;
		background: var(--f0-surface);
	}

	section[hidden],
	.row[hidden] {
		display: none;
	}

	header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.5rem;
	}

	/* One class more than Starlight's `.sl-markdown-content h2`, which adds a top margin. */
	f0-cheatsheet .grid h2 {
		margin: 0;
		color: var(--sl-color-white);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		letter-spacing: 0.02em;
		text-transform: uppercase;
	}

	header a {
		color: var(--sl-color-gray-3);
		font-size: var(--sl-text-xs);
		text-decoration: none;
	}

	header a:hover {
		color: var(--sl-color-text-accent);
	}

	/* Rows share the dl's columns through subgrid, so every key column in a card lines up
	   and is as wide as its longest command, up to 60% of the card. */
	f0-cheatsheet .grid dl {
		display: grid;
		grid-template-columns: fit-content(60%) 1fr;
		column-gap: 0.9rem;
		margin: 0;
	}

	.row {
		display: grid;
		grid-column: 1 / -1;
		grid-template-columns: subgrid;
		align-items: baseline;
		padding: 0.45rem 0;
		border-top: 1px solid var(--sl-color-hairline);
	}

	.row:first-child {
		border-top: 0;
	}

	dt {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem;
		min-width: 0;
	}

	f0-cheatsheet .row dd {
		margin: 0;
		color: var(--sl-color-gray-2);
		font-size: var(--sl-text-sm);
		line-height: 1.4;
	}

	/* Beats Starlight's `.sl-markdown-content :not(pre) > code` chip. */
	f0-cheatsheet .row dt code {
		padding: 0;
		border: 0;
		background: none;
		color: var(--sl-color-text-accent);
		font-family: var(--sl-font-mono);
		font-size: 0.8125rem;
		overflow-wrap: anywhere;
	}

	f0-cheatsheet kbd {
		padding: 0.05rem 0.4rem;
		border: 1px solid var(--sl-color-hairline-light);
		border-bottom-width: 2px;
		border-radius: 0.3rem;
		background: var(--sl-color-black);
		color: var(--sl-color-white);
		font-family: var(--sl-font-mono);
		font-size: 0.75rem;
		line-height: 1.4;
		white-space: nowrap;
	}

	.empty {
		margin-top: 2rem;
		color: var(--sl-color-gray-3);
		text-align: center;
	}

	@media (max-width: 30rem) {
		f0-cheatsheet .grid dl {
			grid-template-columns: 1fr;
		}

		.row {
			row-gap: 0.25rem;
		}
	}

	/* Two columns of cards need more room than a page of prose. */
	:global(:root:has(f0-cheatsheet)) {
		--sl-content-width: 72rem;
	}

	/* Zen mode: only the commands, on a plain background, like VS Code's. */
	:global(:root[data-f0-zen]:has(f0-cheatsheet)) {
		--sl-nav-height: 0rem;
		--sl-sidebar-width: 0rem;
		--sl-content-width: 80rem;
	}

	:global(html[data-f0-zen] body) {
		background: var(--sl-color-black);
	}

	:global(html[data-f0-zen] .page > .header),
	:global(html[data-f0-zen] .sidebar-pane),
	:global(html[data-f0-zen] .content-panel:has(h1)),
	:global(html[data-f0-zen] .main-frame footer) {
		display: none;
	}

	:global(html[data-f0-zen]) .hint {
		display: none;
	}

	:global(html[data-f0-zen]) f0-cheatsheet {
		max-width: 80rem;
		margin: 0 auto;
		padding-block: 2rem;
	}

	/* Without a keyboard the shortcuts in the toolbar and the hint only take room. */
	@media (hover: none) {
		.toolbar kbd,
		.hint {
			display: none;
		}

		.filter input {
			padding-inline-end: 0.9rem;
		}
	}

	@media print {
		:global(.page > .header),
		:global(.sidebar-pane),
		:global(.main-frame footer),
		.toolbar,
		.hint,
		header a {
			display: none;
		}

		:global(body) {
			background: #fff;
		}

		.grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 0.5rem;
			margin-top: 0;
		}

		section {
			break-inside: avoid;
			padding: 0.5rem 0.7rem 0.3rem;
			border-color: #ccc;
			background: #fff;
		}

		f0-cheatsheet .grid h2,
		f0-cheatsheet .row dt code,
		f0-cheatsheet kbd,
		f0-cheatsheet .row dd {
			color: #000;
		}

		kbd {
			background: #fff;
			border-color: #999;
		}

		.row {
			padding: 0.2rem 0;
			border-color: #e5e5e5;
		}
	}
</style>
